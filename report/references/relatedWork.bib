@article{Vykopal,
author = {Vykopal, Jan and \v{S}v\'{a}bensk\'{y}, Valdemar and Chang, Ee-Chien},
title = {Benefits and Pitfalls of Using Capture the Flag Games in University Courses},
year = {2020},
isbn = {9781450367936},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3328778.3366893},
doi = {10.1145/3328778.3366893},
abstract = {The concept of Capture the Flag (CTF) games for practicing cybersecurity skills is widespread in informal educational settings and leisure-time competitions. However, it is not much used in university courses. This paper summarizes our experience from using jeopardy CTF games as homework assignments in an introductory undergraduate course. Our analysis of data describing students' in-game actions and course performance revealed four aspects that should be addressed in the design of CTF tasks: scoring, scaffolding, plagiarism, and learning analytics capabilities of the used CTF platform. The paper addresses these aspects by sharing our recommendations. We believe that these recommendations are useful for cybersecurity instructors who consider using CTF games for assessment in university courses and developers of CTF game frameworks.},
booktitle = {Proceedings of the 51st ACM Technical Symposium on Computer Science Education},
pages = {752–758},
numpages = {7},
keywords = {capture the flag, cybersecurity, educational data mining, homework assignment, learning analytics, plagiarism, summative assessment},
location = {Portland, OR, USA},
series = {SIGCSE '20}
},



