<%- include('partials/header', { title: 'Too many attempts' }) %>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm border-warning">
        <div class="card-body">
          <h3 class="card-title text-warning">Too many login attempts</h3>
          <p class="lead">Your IP has been temporarily locked out due to repeated failed login attempts.</p>
          <p>Please wait <strong id="retrySec"><%= retrySec %></strong> seconds before trying again.</p>
          <div class="mt-3">
            <a class="btn btn-primary" href="/">Back to login</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // simple countdown
    (function () {
      let sec = parseInt(document.getElementById('retrySec').innerText, 10);
      const el = document.getElementById('retrySec');
      if (isNaN(sec) || sec <= 0) return;
      const iv = setInterval(() => {
        sec -= 1;
        if (sec <= 0) { el.innerText = '0'; clearInterval(iv); return; }
        el.innerText = sec;
      }, 1000);
    })();
  </script>

<%- include('partials/footer') %>
