<%- include('partials/header', { title: 'Admins only' }) %>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm border-danger">
        <div class="card-body">
          <h3 class="card-title text-danger">Admins only</h3>
          <p>You found the admin area, but you're not an admin yet.</p>
          <% if (typeof showHint !== 'undefined' && showHint) { %>
            <div class="alert alert-info" role="alert">
              Hint: Think about how the site tracks who you are.
            </div>
          <% } %>
          <p><a class="btn btn-primary" href="/home">Back to home</a></p>
        </div>
      </div>
    </div>
  </div>

<%- include('partials/footer') %>
