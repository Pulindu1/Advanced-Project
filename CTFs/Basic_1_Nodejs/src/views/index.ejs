<%- include('partials/header', { title: 'CTF-1 – Login' }) %>

  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="card-title mb-3">Sign in</h3>
            <p class="text-muted">This is a small web application for your security challenge.</p>

            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger" role="alert"><%= error %></div>
            <% } %>

          <form method="POST" action="/login">
            <div class="mb-3">
              <label class="form-label">Username</label>
              <input class="form-control" type="text" name="username" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input class="form-control" type="password" name="password" required />
            </div>
            <div class="d-grid">
              <button class="btn btn-primary" type="submit">Log in</button>
            </div>
          </form>

          <hr />
          <p class="small text-muted mb-0">Known test account (for students): <code>student / student123</code></p>
        </div>
      </div>
    </div>
  </div>

<%- include('partials/footer') %>
