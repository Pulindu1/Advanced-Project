APP_NAME="HR System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hr_system
DB_USERNAME=hr_admin
DB_PASSWORD=hr_secure_pwd_2026

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# JWT Configuration
JWT_SECRET=change-this-in-production-use-32-chars
JWT_TTL=60

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=60
